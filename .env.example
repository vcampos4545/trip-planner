# Copy to .env and fill in real values. Never commit .env.

# Display name of the product. Optional; defaults to "Trip Planner".
NEXT_PUBLIC_APP_NAME="Trip Planner"

# PostgreSQL. The default matches docker-compose.yml.
DATABASE_URL="postgresql://trip:trip@localhost:5433/trip_planner?schema=public"

# Auth.js. Generate a secret with: openssl rand -base64 33
AUTH_SECRET="replace-with-a-long-random-string"
# Public base URL of the app. Used for OAuth callbacks.
AUTH_URL="http://localhost:3000"
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# AI provider for Atlas. Leave OPENAI_API_KEY empty to run without AI.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6.1-sol"

# Research provider for live search. "none" shows manual entry only.
# "openai_web" uses OpenAI's hosted web search tool with OPENAI_API_KEY (no extra account).
# Each search is billed by OpenAI as a web search tool call plus search content tokens.
RESEARCH_PROVIDER="none"
# Optional, only for RESEARCH_PROVIDER="openai_web". The model defaults to OPENAI_MODEL and the
# context size to "low" (cheapest; "medium" and "high" read more of each page).
OPENAI_WEB_SEARCH_MODEL=""
OPENAI_WEB_SEARCH_CONTEXT_SIZE="low"

# Invitation links expire after this many days unless the organizer picks another value.
INVITE_TTL_DAYS="7"
